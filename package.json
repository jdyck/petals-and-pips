{
  "name": "pips-and-petals",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/require-pnpm.cjs",
    "test": "node scripts/require-pnpm.cjs && node --test tests/*.test.cjs",
    "dev": "node scripts/require-pnpm.cjs && next dev",
    "build": "node scripts/require-pnpm.cjs && next build",
    "start": "node scripts/require-pnpm.cjs && next start",
    "test:online": "node scripts/require-pnpm.cjs && vitest run tests/online-lobby.test.mjs"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "dependencies": {
    "@clerk/nextjs": "^7.10.8",
    "@phosphor-icons/react": "^2.1.10",
    "convex": "^1.51.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-legacy": "npm:three@0.162.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/three-legacy": "npm:@types/three@0.162.0",
    "convex-test": "^0.0.75",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0"
}
